{
  "name": "@smarthorizon-labs/dmn-feel",
  "version": "0.1.0",
  "description": "A FEEL parser and evaluator with DMN-conformant DECIMAL128 decimal arithmetic",
  "keywords": [
    "feel",
    "dmn",
    "feel-parser",
    "feel-engine",
    "decimal",
    "decimal128",
    "expression-language",
    "omg-dmn",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Smart Horizon Consulting",
  "homepage": "https://github.com/smarthorizon-labs/dmn-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarthorizon-labs/dmn-runtime.git",
    "directory": "packages/feel-adapter"
  },
  "bugs": {
    "url": "https://github.com/smarthorizon-labs/dmn-runtime/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lezer/common": "^1.5.4",
    "decimal.js": "^10.4.3",
    "lezer-feel": "^3.0.1",
    "temporal-polyfill": "^1.0.6"
  }
}
