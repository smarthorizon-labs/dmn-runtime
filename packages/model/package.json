{
  "name": "@smarthorizon-labs/dmn-model",
  "version": "0.1.0",
  "description": "Normalized DMN model types: DMN 1.1 through 1.5 documents in one internal shape",
  "keywords": [
    "dmn",
    "dmn-model",
    "decision-model",
    "omg-dmn",
    "typescript",
    "types"
  ],
  "license": "Apache-2.0",
  "author": "Smart Horizon Consulting",
  "homepage": "https://github.com/smarthorizon-labs/dmn-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarthorizon-labs/dmn-runtime.git",
    "directory": "packages/model"
  },
  "bugs": {
    "url": "https://github.com/smarthorizon-labs/dmn-runtime/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
