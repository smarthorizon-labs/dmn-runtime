{
  "name": "@smarthorizon-labs/dmn",
  "version": "0.1.0",
  "description": "TypeScript DMN decision engine: load DMN 1.1-1.5 models, evaluate FEEL and decision tables with DECIMAL128 arithmetic, and get an audit trace",
  "keywords": [
    "dmn",
    "feel",
    "decision-table",
    "decision-model",
    "decision-engine",
    "business-rules",
    "rules-engine",
    "omg-dmn",
    "dmn-tck",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Smart Horizon Consulting",
  "homepage": "https://github.com/smarthorizon-labs/dmn-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarthorizon-labs/dmn-runtime.git",
    "directory": "packages/dmn"
  },
  "bugs": {
    "url": "https://github.com/smarthorizon-labs/dmn-runtime/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smarthorizon-labs/dmn-feel": "0.1.0",
    "@smarthorizon-labs/dmn-model": "0.1.0",
    "@smarthorizon-labs/dmn-runtime": "0.1.0",
    "@smarthorizon-labs/dmn-xml": "0.1.0"
  }
}
